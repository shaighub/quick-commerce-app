# Optional override of the repo-root .env. The API loads apps/api/.env first,
# then fills any missing keys from the repo-root .env. Process env wins over both.
# See the root .env.example for every variable and the local placeholder values.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://qc:qc@localhost:5432/quick_commerce?schema=public&connection_limit=5&pool_timeout=10
JWT_SECRET=local-dev-only-jwt-secret-32chars-min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JOBS_TOKEN=local-dev-only-jobs-token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DELIVERY_FEE_PAISE=2500
SERVICEABLE_PINCODES=560001,560002
IMAGE_HOSTS=images.example.com
