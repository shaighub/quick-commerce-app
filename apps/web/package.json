    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
