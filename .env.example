# Copy to .env at the repo root or to apps/api/.env. Never commit real secrets.
# Local defaults below are placeholders for Docker Compose and a laptop database.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=0.1.0

# connection_limit=5 matches the single-instance pool (NFR-PERF-01 / R11).
DATABASE_URL=postgresql://qc:qc@localhost:5432/quick_commerce?schema=public&connection_limit=5&pool_timeout=10
SHADOW_DATABASE_URL=postgresql://qc:qc@localhost:5432/quick_commerce_shadow?schema=public
TEST_DATABASE_URL=postgresql://qc:qc@localhost:5432/quick_commerce_test?schema=public&connection_limit=5&pool_timeout=10

# At least 32 characters. Generate a unique value per environment.
JWT_SECRET=local-dev-only-jwt-secret-32chars-min
# Access token lifetime in seconds. 900 = 15 minutes.
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds. 604800 = 7 days.
JWT_REFRESH_TTL_SECONDS=604800
# At least 16 characters. Sent as X-Jobs-Token to POST /v1/internal/jobs/sweep.
JOBS_TOKEN=local-dev-only-jobs-token

# Seed refuses an empty or weak password (8+ characters, one letter, one number).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Integer paise. 2500 = Rs 25.00.
DELIVERY_FEE_PAISE=2500
# Comma-separated 6-digit Indian pincodes.
SERVICEABLE_PINCODES=560001,560002
# Hostnames only, no scheme. Also used in the API Content-Security-Policy img-src.
IMAGE_HOSTS=images.example.com
# Optional. The storefront image check uses this list and defaults to images.example.com.
# VITE_IMAGE_HOSTS=images.example.com

# OpenAPI UI is on outside production unless this is set. true or false.
# DOCS_ENABLED=true

# Optional. When set to an https Sentry DSN, unhandled API errors are reported with the request id.
# Leave empty in git. Do not commit a real DSN (ADR-017).
SENTRY_DSN=

# Requests per minute per IP. Defaults match NFR-SEC-02 when unset.
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WINDOW_MS=60000
SHUTDOWN_TIMEOUT_MS=10000
